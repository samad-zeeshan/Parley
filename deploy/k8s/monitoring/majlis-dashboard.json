{
  "title": "Majlis",
  "uid": "majlis",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Booking actions per second, by action and outcome",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (action, outcome) (rate(majlis_booking_actions_total[1m]))",
                   "legendFormat": "{{action}} {{outcome}}"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Dialogue turns per second, by detected language and dialect",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (dialect) (rate(majlis_agent_turns_total[5m]))",
                   "legendFormat": "{{dialect}}"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stage latency p95 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A",
                   "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(majlis_stage_seconds_bucket[5m])))",
                   "legendFormat": "p95 {{stage}}"},
                  {"refId": "B",
                   "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(majlis_stage_seconds_bucket[5m])))",
                   "legendFormat": "p50 {{stage}}"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejections in the last hour",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(majlis_grounding_rejections_total[1h]))",
                   "legendFormat": "model replies rejected by grounding"},
                  {"refId": "B", "expr": "sum(increase(majlis_tool_rejections_total[1h]))",
                   "legendFormat": "tool calls rejected by schema"},
                  {"refId": "C",
                   "expr": "sum(increase(majlis_booking_actions_total{outcome!~\"ok|replay\"}[1h]))",
                   "legendFormat": "booking API errors"}]
    }
  ]
}
